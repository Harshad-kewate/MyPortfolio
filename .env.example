# ==============================================================================
# PORTFOLIO CONTACT FORM - ENVIRONMENT VARIABLES
# ==============================================================================
# The backend (/api/contact) securely delivers messages directly to: kewateharshad@gmail.com
#
# Choose ANY of the options below. In production on Vercel, simply add these in
# your Vercel Project Settings -> Environment Variables.

# --- OPTION 1: Resend (RECOMMENDED FOR VERCEL & NEXT.JS) ---
# Free 3,000 emails/month: https://resend.com
RESEND_API_KEY=
# FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# --- OPTION 2: Gmail SMTP (Using Google App Password) ---
# Enable 2-Step Verification on your Google Account, then generate an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=kewateharshad@gmail.com
GMAIL_APP_PASSWORD=

# --- OPTION 3: Custom SMTP (Brevo, SendGrid, Amazon SES, etc.) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=kewateharshad@gmail.com
# SMTP_PASS=

# --- OPTION 4: Web3Forms (Free 250 emails/month, no password needed) ---
# Get an access key instantly at https://web3forms.com
# WEB3FORMS_ACCESS_KEY=

# Target recipient email (defaults to kewateharshad@gmail.com)
CONTACT_RECIPIENT_EMAIL=kewateharshad@gmail.com
